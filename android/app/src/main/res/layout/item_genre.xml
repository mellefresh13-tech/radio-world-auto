<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="126dp"
    android:layout_margin="5dp"
    android:background="@drawable/bg_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="12dp">

    <ImageView
        android:id="@+id/genreIcon"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:src="@drawable/ic_music_note"
        android:tint="@color/auto_accent"
        android:background="@drawable/bg_surface"
        android:padding="17dp"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/genreName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Rock"
            android:textColor="@color/auto_text_main"
            android:textSize="19sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/genreCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="120 stations"
            android:textColor="@color/auto_text_muted"
            android:textSize="13sp"
            android:includeFontPadding="false" />
    </LinearLayout>

    <TextView
        android:layout_width="36dp"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="›"
        android:textColor="@color/auto_text_dark"
        android:textSize="28sp" />
</LinearLayout>