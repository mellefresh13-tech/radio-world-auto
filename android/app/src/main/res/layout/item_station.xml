<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp">

    <TextView
        android:id="@+id/logoText"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_accent"
        android:gravity="center"
        android:text="R"
        android:textColor="#0B0E14"
        android:textSize="20sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/stationTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Station"
            android:textColor="@color/auto_text_main"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/stationMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Germany • Rock • Munich"
            android:textColor="@color/auto_accent"
            android:textSize="12sp" />
    </LinearLayout>

    <Button
        android:id="@+id/favoriteButton"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:background="@drawable/bg_card"
        android:text="☆"
        android:textColor="@color/auto_text_muted"
        android:textSize="22sp" />

    <Button
        android:id="@+id/playButton"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/bg_accent"
        android:text="▶"
        android:textColor="@color/auto_bg"
        android:textSize="20sp" />
</LinearLayout>
