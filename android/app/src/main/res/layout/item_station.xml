<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="132dp"
    android:layout_margin="5dp"
    android:background="@drawable/bg_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="12dp">

    <ImageView
        android:id="@+id/logoImage"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/bg_logo"
        android:padding="10dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_radio"
        android:tint="@color/auto_accent"
        android:contentDescription="@null"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/stationTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Station"
            android:textColor="@color/auto_text_main"
            android:textSize="17sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:singleLine="true"
            android:scrollHorizontally="true"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"

        <TextView
            android:id="@+id/stationMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Germany • Rock • Munich"
            android:textColor="@color/auto_text_muted"
            android:textSize="11sp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:singleLine="true"
            android:scrollHorizontally="true"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:selected="true"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_surface"
            android:gravity="center_vertical"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:text="LIVE"
            android:textColor="@color/auto_accent"
            android:textSize="8sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:includeFontPadding="false"/>
    </LinearLayout>

    <ImageButton
        android:id="@+id/favoriteButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_icon_button"
        android:src="@drawable/ic_star_outline"
        android:scaleType="center"
        android:contentDescription="Favorite"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp"/>

    <ImageButton
        android:id="@+id/playButton"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_giant_play"
        android:src="@drawable/ic_play"
        android:scaleType="center"
        android:contentDescription="Play"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp"/>
</LinearLayout>