<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="76dp"
    android:layout_marginBottom="7dp"
    android:background="@drawable/bg_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="10dp">

    <TextView
        android:id="@+id/logoText"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_accent"
        android:gravity="center"
        android:text="R"
        android:textColor="#0B0E14"
        android:textSize="19sp"
        android:textStyle="bold"
        android:includeFontPadding="false" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/stationTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Station"
            android:textColor="@color/auto_text_main"
            android:textSize="16sp"
            android:textStyle="bold"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/stationMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Germany • Rock • Munich"
            android:textColor="@color/auto_accent"
            android:textSize="11sp"
            android:includeFontPadding="false" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/favoriteButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_icon_button"
        android:src="@drawable/ic_star_outline"
        android:scaleType="center"
        android:contentDescription="Favorite"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp" />

    <ImageButton
        android:id="@+id/playButton"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginStart="5dp"
        android:background="@drawable/bg_primary_button"
        android:src="@drawable/ic_play"
        android:scaleType="center"
        android:contentDescription="Play"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp" />
</LinearLayout>
