<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/auto_bg">

    <FrameLayout
        android:id="@+id/contentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/auto_bg" />

    <LinearLayout
        android:id="@+id/navContainer"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@color/auto_surface"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/navBrandIcon"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="center"
            android:layout_marginBottom="10dp"
            android:src="@drawable/app_logo"
            android:scaleType="centerInside"
            android:visibility="gone"
            android:contentDescription="@string/app_name" />

        <TextView
            android:id="@+id/navBrandLabel"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:gravity="center"
            android:text="@string/app_name"
            android:textColor="@color/auto_text_main"
            android:textSize="14sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/navNowPlayingCard"
            android:layout_width="match_parent"
            android:layout_height="104dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_nav_now_playing"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            android:contentDescription="Now playing">

            <ImageView
                android:id="@+id/navNowLogo"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_logo"
                android:padding="7dp"
                android:scaleType="centerInside"
                android:src="@drawable/app_logo"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/navNowFavorite"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="7dp"
                android:layout_marginEnd="7dp"
                android:background="@drawable/bg_icon_button"
                android:padding="5dp"
                android:src="@drawable/ic_star_outline"
                android:contentDescription="Favorite current station" />

            <TextView
                android:id="@+id/navNowStation"
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:layout_gravity="bottom"
                android:layout_marginStart="9dp"
                android:layout_marginEnd="9dp"
                android:layout_marginBottom="25dp"
                android:gravity="center"
                android:textColor="@color/auto_text_main"
                android:textSize="12sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="marquee"
                android:singleLine="true" />

            <TextView
                android:id="@+id/navNowTrack"
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:layout_gravity="bottom"
                android:layout_marginStart="9dp"
                android:layout_marginEnd="9dp"
                android:layout_marginBottom="9dp"
                android:gravity="center"
                android:textColor="@color/auto_text_muted"
                android:textSize="10sp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="marquee"
                android:singleLine="true" />

        </FrameLayout>

        <Button
            android:id="@+id/navPlayer"
            style="@style/NavItemButton"
            android:drawableTop="@drawable/ic_radio"
            android:text="Player" />

        <Button
            android:id="@+id/navCountries"
            style="@style/NavItemButton"
            android:drawableTop="@drawable/ic_globe"
            android:text="Countries" />

        <Button
            android:id="@+id/navGenres"
            style="@style/NavItemButton"
            android:drawableTop="@drawable/ic_grid"
            android:text="Genres" />

        <Button
            android:id="@+id/navFavorites"
            style="@style/NavItemButton"
            android:drawableTop="@drawable/ic_star_outline"
            android:text="Favorites" />

        <Button
            android:id="@+id/navRecents"
            style="@style/NavItemButton"
            android:drawableTop="@drawable/ic_history"
            android:text="Recent" />

        <Button
            android:id="@+id/navSearch"
            style="@style/NavItemButton"
            android:drawableTop="@drawable/ic_search"
            android:text="Search" />
    </LinearLayout>
</LinearLayout>
