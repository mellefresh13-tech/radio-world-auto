<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/auto_bg"
    android:clipToPadding="false">

    <FrameLayout
        android:id="@+id/contentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="10dp" />

    <GridLayout
        android:id="@+id/navBar"
        android:layout_width="match_parent"
        android:layout_height="128dp"
        android:columnCount="3"
        android:rowCount="2"
        android:background="@color/auto_surface"
        android:padding="6dp">

        <Button
            android:id="@+id/navPlayer"
            style="@style/NavItemButton"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:drawableTop="@drawable/ic_radio"
            android:text="Player" />

        <Button
            android:id="@+id/navCountries"
            style="@style/NavItemButton"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:drawableTop="@drawable/ic_globe"
            android:text="Countries" />

        <Button
            android:id="@+id/navGenres"
            style="@style/NavItemButton"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:drawableTop="@drawable/ic_grid"
            android:text="Genres" />

        <Button
            android:id="@+id/navFavorites"
            style="@style/NavItemButton"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:drawableTop="@drawable/ic_star_outline"
            android:text="Favorites" />

        <Button
            android:id="@+id/navRecents"
            style="@style/NavItemButton"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:drawableTop="@drawable/ic_history"
            android:text="Recent" />

        <Button
            android:id="@+id/navSearch"
            style="@style/NavItemButton"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:drawableTop="@drawable/ic_search"
            android:text="Search" />
    </GridLayout>
</LinearLayout>
