<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/auto_bg">

    <TextView
        android:id="@+id/activeAppTitle"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@color/auto_surface"
        android:gravity="center_vertical"
        android:paddingHorizontal="18dp"
        android:text="◉  RADIO WORLD AUTO"
        android:textColor="@color/auto_text_main"
        android:textSize="18sp"
        android:textStyle="bold" />

    <FrameLayout
        android:id="@+id/contentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="14dp" />

    <GridLayout
        android:id="@+id/navBar"
        android:layout_width="match_parent"
        android:layout_height="128dp"
        android:columnCount="3"
        android:rowCount="2"
        android:background="@color/auto_surface"
        android:padding="6dp">

        <Button android:id="@+id/navPlayer" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:text="▶ PLAYER" android:textSize="13sp" />
        <Button android:id="@+id/navCountries" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:text="◉ COUNTRIES" android:textSize="13sp" />
        <Button android:id="@+id/navGenres" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:text="♫ GENRES" android:textSize="13sp" />
        <Button android:id="@+id/navFavorites" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:text="★ FAVORITES" android:textSize="13sp" />
        <Button android:id="@+id/navRecents" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:text="↶ RECENT" android:textSize="13sp" />
        <Button android:id="@+id/navSearch" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:text="⌕ SEARCH" android:textSize="13sp" />
    </GridLayout>
</LinearLayout>
