<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="136dp"
    android:layout_margin="5dp"
    android:background="@drawable/bg_card"
    android:elevation="2dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="12dp">

    <TextView
        android:id="@+id/countryFlag"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/bg_icon_badge"
        android:gravity="center"
        android:text="🇩🇪"
        android:textSize="34sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/countryName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="Germany"
            android:textColor="@color/auto_text_main"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/countryCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:includeFontPadding="false"
            android:letterSpacing="0.03"
            android:text="120 stations"
            android:textColor="@color/auto_text_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_icon_button"
        android:contentDescription="@null"
        android:padding="10dp"
        android:src="@drawable/ic_chevron_right"
        android:tint="@color/auto_text_muted" />
</LinearLayout>
