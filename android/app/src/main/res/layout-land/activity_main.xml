<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/auto_bg">

    <LinearLayout
        android:layout_width="220dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="18dp"
        android:paddingEnd="14dp"
        android:paddingBottom="16dp"
        android:background="@color/auto_surface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_icon_badge"
                android:src="@drawable/ic_radio"
                android:tint="@color/auto_accent"
                android:scaleType="center"
                android:contentDescription="@null"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="11dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="RADIO WORLD"
                    android:textColor="@color/auto_text_main"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="WORLDWIDE RADIO"
                    android:textColor="@color/auto_text_muted"
                    android:textSize="8sp"
                    android:letterSpacing="0.08"
                    android:includeFontPadding="false"/>
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="18dp"/>

        <Button android:id="@+id/navPlayer" style="@style/SidebarNavItemButton"
            android:drawableStart="@drawable/ic_radio" android:text="Now playing"/>
        <Button android:id="@+id/navCountries" style="@style/SidebarNavItemButton"
            android:drawableStart="@drawable/ic_globe" android:text="Countries"/>
        <Button android:id="@+id/navGenres" style="@style/SidebarNavItemButton"
            android:drawableStart="@drawable/ic_grid" android:text="Genres"/>
        <Button android:id="@+id/navFavorites" style="@style/SidebarNavItemButton"
            android:drawableStart="@drawable/ic_star_outline" android:text="Favorites"/>
        <Button android:id="@+id/navRecents" style="@style/SidebarNavItemButton"
            android:drawableStart="@drawable/ic_history" android:text="Recently played"/>
        <Button android:id="@+id/navSearch" style="@style/SidebarNavItemButton"
            android:drawableStart="@drawable/ic_search" android:text="Search"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:gravity="center_vertical"
            android:background="@drawable/bg_card"
            android:paddingStart="12dp"
            android:paddingEnd="10dp">

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_accent"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="ONLINE CATALOG"
                android:textColor="@color/auto_text_muted"
                android:textSize="9sp"
                android:letterSpacing="0.06"
                android:includeFontPadding="false"/>
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/contentContainer"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@color/auto_bg"/>
</LinearLayout>