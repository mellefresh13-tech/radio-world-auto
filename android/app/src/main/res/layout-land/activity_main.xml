<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/auto_bg">

    <LinearLayout
        android:id="@+id/navRail"
        android:layout_width="184dp"
        android:layout_height="match_parent"
        android:background="@color/auto_surface"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center"
            android:text="◉ RADIO WORLD"
            android:textColor="@color/auto_accent"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button android:id="@+id/navPlayer" android:layout_width="match_parent" android:layout_height="64dp" android:text="▶ PLAYER" android:textSize="12sp" />
        <Button android:id="@+id/navCountries" android:layout_width="match_parent" android:layout_height="64dp" android:text="◉ COUNTRIES" android:textSize="12sp" />
        <Button android:id="@+id/navGenres" android:layout_width="match_parent" android:layout_height="64dp" android:text="♫ GENRES" android:textSize="12sp" />
        <Button android:id="@+id/navFavorites" android:layout_width="match_parent" android:layout_height="64dp" android:text="★ FAVORITES" android:textSize="12sp" />
        <Button android:id="@+id/navRecents" android:layout_width="match_parent" android:layout_height="64dp" android:text="↶ RECENT" android:textSize="12sp" />
        <Button android:id="@+id/navSearch" android:layout_width="match_parent" android:layout_height="64dp" android:text="⌕ SEARCH" android:textSize="12sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/activeAppTitle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@color/auto_surface"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:text="RADIO WORLD AUTO"
            android:textColor="@color/auto_text_main"
            android:textSize="16sp"
            android:textStyle="bold" />

        <FrameLayout
            android:id="@+id/contentContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="14dp" />
    </LinearLayout>
</LinearLayout>
