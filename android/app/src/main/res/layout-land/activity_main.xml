<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/auto_bg"
    android:clipToPadding="false">

    <ScrollView
        android:layout_width="@dimen/sidebar_width"
        android:layout_height="match_parent"
        android:background="@color/auto_surface"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/navBar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="8dp">

            <Button
                android:id="@+id/navPlayer"
                style="@style/SidebarNavItemButton"
                android:drawableStart="@drawable/ic_radio"
                android:text="PLAYER" />

            <Button
                android:id="@+id/navCountries"
                style="@style/SidebarNavItemButton"
                android:drawableStart="@drawable/ic_globe"
                android:text="COUNTRIES" />

            <Button
                android:id="@+id/navGenres"
                style="@style/SidebarNavItemButton"
                android:drawableStart="@drawable/ic_grid"
                android:text="GENRES" />

            <Button
                android:id="@+id/navFavorites"
                style="@style/SidebarNavItemButton"
                android:drawableStart="@drawable/ic_star_outline"
                android:text="FAVORITES" />

            <Button
                android:id="@+id/navRecents"
                style="@style/SidebarNavItemButton"
                android:drawableStart="@drawable/ic_history"
                android:text="RECENT" />

            <Button
                android:id="@+id/navSearch"
                style="@style/SidebarNavItemButton"
                android:drawableStart="@drawable/ic_search"
                android:text="SEARCH" />
        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/contentContainer"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:padding="14dp" />
</LinearLayout>
