<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="NavItemButton">
        <item name="android:layout_width">0dp</item><item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item><item name="android:background">@drawable/bg_nav_item</item>
        <item name="android:textColor">@color/auto_text_muted</item><item name="android:textSize">9sp</item>
        <item name="android:textAllCaps">false</item><item name="android:includeFontPadding">false</item><item name="android:gravity">center</item>
        <item name="android:drawablePadding">2dp</item><item name="android:drawableTint">@color/auto_text_muted</item>
        <item name="android:minWidth">0dp</item><item name="android:minHeight">0dp</item>
        <item name="android:stateListAnimator">@null</item><item name="android:elevation">0dp</item>
        <item name="android:padding">4dp</item><item name="android:layout_margin">3dp</item>
    </style>
    <style name="SidebarNavItemButton">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">@dimen/nav_item_height</item>
        <item name="android:layout_marginBottom">6dp</item><item name="android:background">@drawable/bg_nav_item</item>
        <item name="android:textColor">@color/auto_text_muted</item><item name="android:textSize">11sp</item>
        <item name="android:textAllCaps">false</item><item name="android:includeFontPadding">false</item>
        <item name="android:gravity">center_vertical|start</item><item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">10dp</item><item name="android:drawablePadding">12dp</item>
        <item name="android:drawableTint">@color/auto_text_muted</item><item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item><item name="android:stateListAnimator">@null</item><item name="android:elevation">0dp</item>
    </style>
</resources>