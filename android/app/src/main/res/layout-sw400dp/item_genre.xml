<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="116dp"
    android:layout_margin="5dp"
    android:background="@drawable/bg_card"
    android:elevation="2dp">

    <ImageView
        android:id="@+id/genreIcon"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="10dp"
        android:background="@drawable/bg_icon_badge"
        android:padding="12dp"
        android:src="@drawable/ic_music_note"
        android:tint="@color/auto_accent"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="70dp"
        android:layout_marginEnd="48dp"
        android:layout_gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/genreName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="marquee"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:singleLine="true"
            android:text="Rock"
            android:textColor="@color/auto_text_main"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/genreCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:includeFontPadding="false"
            android:letterSpacing="0.02"
            android:text="120 stations"
            android:textColor="@color/auto_text_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageView
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_icon_button"
        android:contentDescription="@null"
        android:padding="8dp"
        android:src="@drawable/ic_chevron_right"
        android:tint="@color/auto_text_muted" />
</FrameLayout>